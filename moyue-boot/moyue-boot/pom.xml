<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.moyue</groupId>
        <artifactId>moyue-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>moyue-boot</artifactId>

    <name>moyue-boot</name>
    <description>单体启动器（8080，仅 boot 仓）：聚合全部业务模块，替代 moyue-gateway</description>

    <dependencies>
        <!-- 通用能力 -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>common-migration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>common-monitor</artifactId>
        </dependency>

        <!-- 业务模块：单体形态下全部打进一个 jar -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-auth</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-system</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-content</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-social</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-commerce</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-search</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-message</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-risk</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-ai</artifactId>
            <version>${moyue.common.version}</version>
        </dependency>

        <!-- 服务契约（Feign 接口 + 降级实现，boot 模式走本地实现） -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>api-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>api-content</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>api-social</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>api-commerce</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>api-search</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>api-message</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>api-risk</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>moyue-boot</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
