# 墨阅小说网 · 环境变量样例（P2-17 配置治理 / E-1~E-3）
# ---------------------------------------------------------------------------
# 用法：复制为 .env（或按 CI/部署平台注入），按环境填写实际值。
# 约定（架构设计 §三 D9）：
#   - dev  profile 允许保留本地默认值（开箱即启动）；
#   - test/prod profile 必须经环境变量强制注入，仓库内不得出现明文口令。
# ⚠️ 本文件仅为样例，严禁写入任何真实密钥；生产密钥由运维/密钥管理系统注入。
# ---------------------------------------------------------------------------

# ---- 运行环境 ----
# dev | test | prod（默认 dev）
SPRING_PROFILES_ACTIVE=dev

# ---- MySQL（敏感项，prod/test 必填）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=moyue
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Elasticsearch（检索域，单体 moyue-app 内，只读，可选）----
ES_URIS=http://localhost:9200

# ---- JWT（单体应用 JWT 签名密钥，prod 必填且需强随机）----
MOYUE_JWT_SECRET=

# ---- 邮件渠道（触达域，单体 moyue-app 内；dev 默认指向 MailHog，无认证）----
MOYUE_MAIL_HOST=localhost
MOYUE_MAIL_PORT=1025
MOYUE_MAIL_USERNAME=
MOYUE_MAIL_PASSWORD=
MOYUE_MAIL_FROM=no-reply@moyue.local

# ---- Sentinel（接口限流 / 熔断，P2-17）----
MOYUE_SENTINEL_ENABLED=true
# 每路由默认 QPS 上限（可配）
MOYUE_SENTINEL_ROUTE_QPS=100

# ---- XXL-Job（执行器随 moyue-app 进程启动，RPC 9099）----
XXL_JOB_ADMIN_ADDRESSES=http://localhost:8088/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=
