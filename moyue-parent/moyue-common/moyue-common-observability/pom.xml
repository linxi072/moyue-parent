<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.moyue</groupId>
        <artifactId>moyue-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>moyue-common-observability</artifactId>
    <packaging>jar</packaging>
    <name>moyue-common-observability</name>
    <description>墨阅小说网 · 可观测性组件：TraceId 透传 + Micrometer/Prometheus 指标 + logstash JSON 日志（P2-G）</description>

    <dependencies>
        <!-- 公共常量（Constants.TRACE_ID_HEADER） -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-core</artifactId>
        </dependency>
        <!-- 指标与端点（版本由 Spring Boot 父 POM 管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Feign 透传拦截器：仅编译期需要 RequestInterceptor 超接口，运行时由 openfeign 模块实际装配 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 测试：Mock 单测（TraceIdFilter / TraceIdFeignInterceptor） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
