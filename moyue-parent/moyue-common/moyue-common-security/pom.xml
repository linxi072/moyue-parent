<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.moyue</groupId>
        <artifactId>moyue-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>moyue-common-security</artifactId>
    <packaging>jar</packaging>
    <name>moyue-common-security</name>
    <description>墨阅小说网 · 安全组件：JWT 签发解析 / 管理端角色拦截器 / WebMvc 装配（对齐 RuoYi ruoyi-common-security）</description>

    <dependencies>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-core</artifactId>
        </dependency>
        <!-- P2-G 可观测性：TraceId 透传 + Prometheus 指标 + logstash JSON 日志；随安全组件传递至全服务 -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-observability</artifactId>
        </dependency>
        <!-- JWT（jjwt 0.12.x） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- AOP：@RequiresRoles / @RequiresPermissions 注解切面（PreAuthorizeAspect） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- WebMvcConfig / AdminRoleInterceptor 编译所需（@ConditionalOnWebApplication 保证仅在 servlet 环境装配） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Feign：ServiceTokenRequestInterceptor 实现 feign.RequestInterceptor，需 feign-core 在编译/运行期可见
             （@ConditionalOnClass 仅跳过 Bean 注册，无法避免 JVM 加载类时因缺失超接口而 NoClassDefFoundError）。
             feign-core 不触发 FeignAutoConfiguration，非 openfeign 模块引入无害。 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 测试：Mock 单测（P2-I 安全组件单测：CidrFilter / InternalAuthInterceptor） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
