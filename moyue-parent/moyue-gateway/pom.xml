<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.moyue</groupId>
        <artifactId>moyue-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>moyue-gateway</artifactId>
    <packaging>jar</packaging>
    <name>moyue-gateway</name>
    <description>墨阅小说网 · 网关：静态路由 / JWT 统一鉴权 / 跨域（Spring Cloud Gateway，端口 8080）</description>

    <dependencies>
        <!-- 网关（WebFlux 实现，注意不要引入 spring-boot-starter-web） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <!-- 通用模块（R&lt;T&gt; / JWT / 常量） -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common</artifactId>
        </dependency>
        <!-- 服务发现：解析 lb:// 路由目标（各业务服务注册到 Nacos） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- ===== 限流 / 熔断：Sentinel（P2-17，版本由 spring-cloud-alibaba BOM 管理，不写版本号） ===== -->
        <!-- sentinel 核心（RuleConstant / DegradeRule / DegradeRuleManager 等） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- Sentinel 网关适配器：自动装配 SentinelGatewayFilter / SentinelGatewayBlockExceptionHandler，
             并暴露 GatewayRuleManager / GatewayCallbackManager（自定义降级体 R<T>，HTTP 200） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-alibaba-sentinel-gateway</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
