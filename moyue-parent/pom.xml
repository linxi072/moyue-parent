<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 父 POM，统一依赖与插件版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.moyue</groupId>
    <artifactId>moyue-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>moyue-parent</name>
    <description>墨阅小说网 · Maven 多模块父工程（RuoYi 目录风格：common 细拆 / api 契约 / gateway / auth / modules 业务聚合）</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2023.0.5</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <xxl-job.version>2.4.0</xxl-job.version>
        <testcontainers.version>1.19.8</testcontainers.version>
    </properties>

    <!--
      子模块（12 个 = 3 基础 + 9 业务，按领域收敛；P2-13~17 由 9 扩为 12）：
        基础层：common（公共）· api（跨服务契约）· gateway（网关）
        账号域 account  ：auth（认证）+ user（用户资料）
        内容域 content  ：book（书城）+ chapter（章节）+ read（阅读书架）
        社区域 social   ：comment（评论）+ blog（博客）+ im（即时通讯）
        商业域 commerce ：points（积分）+ merch（周边商城）+ author（稿酬）
        平台域 platform ：operation（运营）+ stat（统计）+ system（系统管理）+ job（调度）
        智能域 ai       ：AI 智能客服（独立能力域，便于单独扩容）
        检索域 search   ：全文检索 / 推荐（只读 Elasticsearch，端口 8085，P2-13 新增）
        触达域 message  ：站内信 + 渠道分发 + 触达记录（端口 8087，P2-14 新增）
        内容安全域 risk ：敏感词 + 机审 + 举报 + 人工审核（端口 8089，P2-15 新增）
      说明：各业务模块内部保留原 `com.moyue.<旧包名>` 子包不变（模块 ≠ 包名），由启动类
      `@ComponentScan("com.moyue")` 统一扫描；迁移时包名保持不变，HTTP 路径零变更。
    -->
                    <modules>
        <module>moyue-common</module>
        <module>moyue-api</module>
        <module>moyue-gateway</module>
        <module>moyue-auth</module>
        <module>moyue-modules</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud 2023.0.x（与 Spring Boot 3.2.x 兼容） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba（Nacos 注册/配置、Sentinel 等） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块（聚合器 + 细粒度子模块，对齐 RuoYi 命名） -->
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-common-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-common-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-common-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-common-migration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-api-account</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-api-content</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-api-social</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-api-commerce</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-api-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-api-message</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-api-risk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moyue</groupId>
                <artifactId>moyue-api-ai</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus（Spring Boot 3 系必须使用 boot3 starter，否则拉到 mybatis-spring 2.x 与 Spring 6.1 不兼容） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- XXL-Job 调度执行器 -->
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>

            <!-- JWT（jjwt 0.12.x） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
