<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.moyue</groupId>
        <artifactId>moyue-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>moyue-contract</artifactId>
    <packaging>jar</packaging>
    <name>moyue-contract</name>
    <description>墨阅小说网 · 契约工具链：以 openapi-generator 从各服务 /v3/api-docs 生成前端 TypeScript 客户端（含静态 sample spec 验证链路，零集群依赖）</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.7.0</version>
                <executions>
                    <!--
                      验证链路（无活集群）：用提交的静态 sample spec 证明生成器端到端可用。
                      活集群就绪后，复制本 execution 并把 inputSpec 换成
                      <url>http://localhost:8080/api/v1/docs/&lt;svc&gt;/v3/api-docs</url> 即可批量产出生产客户端。
                    -->
                    <execution>
                        <id>gen-sample</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/specs/sample-system.json</inputSpec>
                            <generatorName>typescript-axios</generatorName>
                            <output>${project.basedir}/../moyue-frontend/src/api/sample</output>
                            <apiPackage>api</apiPackage>
                            <modelPackage>model</modelPackage>
                            <addCompileSourceRoot>false</addCompileSourceRoot>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <supportsES6>true</supportsES6>
                                <withSeparateModelsAndApi>true</withSeparateModelsAndApi>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
