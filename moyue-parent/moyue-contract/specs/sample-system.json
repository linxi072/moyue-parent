{
  "openapi": "3.0.1",
  "info": {
    "title": "moyue-system",
    "version": "1.0.0-SNAPSHOT",
    "description": "墨阅小说网 · 平台运营域服务（sample spec，用于验证 openapi-generator 代码生成链路，字段取自 RewardController 真实端点）"
  },
  "servers": [
    { "url": "http://localhost:8086", "description": "moyue-system" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RewardOrder": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "orderNo": { "type": "string" },
          "userId": { "type": "integer", "format": "int64" },
          "bookId": { "type": "integer", "format": "int64" },
          "chapterId": { "type": "integer", "format": "int64" },
          "amount": { "type": "number", "format": "decimal" },
          "payChannel": { "type": "integer", "format": "int32", "description": "1 微信 / 2 支付宝" },
          "status": { "type": "integer", "format": "int32", "description": "0 待支付 / 1 已支付 / 2 已关闭" },
          "payTime": { "type": "string", "format": "date-time" },
          "createTime": { "type": "string", "format": "date-time" }
        }
      },
      "CreateRewardRequest": {
        "type": "object",
        "required": ["bookId", "amount"],
        "properties": {
          "bookId": { "type": "integer", "format": "int64" },
          "chapterId": { "type": "integer", "format": "int64" },
          "amount": { "type": "number", "format": "decimal" },
          "payChannel": { "type": "integer", "format": "int32" }
        }
      },
      "R": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "type": "object", "nullable": true }
        }
      }
    }
  },
  "security": [ { "bearerAuth": [] } ],
  "paths": {
    "/api/v1/rewards": {
      "post": {
        "summary": "创建打赏订单（待支付）",
        "operationId": "createReward",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateRewardRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/R" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "我的打赏记录",
        "operationId": "myRewards",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/R" } } }
          }
        }
      }
    },
    "/api/v1/rewards/{orderNo}/pay": {
      "post": {
        "summary": "支付（模拟渠道回调，幂等）",
        "operationId": "payReward",
        "parameters": [
          { "name": "orderNo", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/R" } } }
          }
        }
      }
    },
    "/api/v1/rewards/income": {
      "get": {
        "summary": "我的稿酬流水（作者视角）",
        "operationId": "myIncome",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/R" } } }
          }
        }
      }
    },
    "/api/v1/rewards/income/summary": {
      "get": {
        "summary": "稿酬汇总（累计 + 本月）",
        "operationId": "incomeSummary",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/R" } } }
          }
        }
      }
    }
  }
}
