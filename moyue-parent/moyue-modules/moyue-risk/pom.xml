<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.moyue</groupId>
        <artifactId>moyue-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>moyue-risk</artifactId>
    <packaging>jar</packaging>
    <name>moyue-risk</name>
    <description>墨阅小说网 · 内容安全域服务：敏感词 / 机审 / 举报 / 人工审核 audit（端口 8089）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-migration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-api-content</artifactId>
        </dependency>
        <!-- P2-15：本服务是 RiskClient 契约的服务端实现，ModerationRequest/ResultDTO 在此定义 -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-api-risk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-api-social</artifactId>
        </dependency>
        <!-- P2-15 举报闭环：处理结果按 REPORT_RESULT 模板触达举报人 -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-api-message</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign 走服务发现（name=）必须引入负载均衡实现，否则启动失败 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Sentinel：Feign 降级（fallbackFactory）与熔断限流（P2-16） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- QA 验证：单测（JUnit 5 / Mockito / AssertJ），不参与发布产物 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- springdoc-openapi：契约元信息（版本由根 POM BOM 管理，经 common-core 自动配置生效） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.moyue.risk.RiskApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
