<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.moyue</groupId>
        <artifactId>moyue-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>moyue-system</artifactId>
    <packaging>jar</packaging>
    <name>moyue-system</name>
    <description>墨阅小说网 · 平台运营域服务：系统管理 RBAC system / 运营公告对账 operation / 统计 stat / XXL-Job 调度 job / 打赏（端口 8086）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-migration</artifactId>
        </dependency>
        <!-- 系统管理二期：Redis（在线用户会话 / 字典参数缓存 / 令牌黑名单） -->
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-common-redis</artifactId>
        </dependency>
        <!-- common-redis 中 data-redis 为 optional 不传递，须显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 运维观测端点（health/info/metrics，供 /monitor 之外的基础巡检） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 服务监控页面 API 文档（prod 关闭） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>
        <!-- 代码生成器模板引擎 -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>2.3</version>
        </dependency>
        <!-- HikariCP 池监控（MyBatis-Plus starter 已随带，显式声明便于 MonitorService 直接引用） -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-api-account</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-api-content</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-api-message</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moyue</groupId>
            <artifactId>moyue-api-social</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign 走服务发现（name=）必须引入负载均衡实现，否则启动失败 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Sentinel：Feign 降级（fallbackFactory）与熔断限流（P2-16） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
        <!-- BCrypt 密码哈希（仅 crypto，不引入 web 安全过滤链） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- QA 验证：单测（JUnit 5 / Mockito / AssertJ），不参与发布产物 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- QA 验证：H2 内存库解析 V14 迁移 SQL（MySQL 兼容模式），test 生命周期独占 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.moyue.system.SystemApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
