# 墨阅小说网 · 环境变量样例（P2-17 配置治理 / E-1~E-3）
# ---------------------------------------------------------------------------
# 用法：复制为 .env（或按 CI/部署平台注入），按环境填写实际值。
# 约定（架构设计 §三 D9）：
#   - dev  profile 允许保留本地默认值（开箱即启动）；
#   - test/prod profile 必须经环境变量强制注入，仓库内不得出现明文口令。
# ⚠️ 本文件仅为样例，严禁写入任何真实密钥；生产密钥由运维/密钥管理系统注入。
# ---------------------------------------------------------------------------

# ---- 运行环境 ----
# dev | test | prod（默认 dev）
SPRING_PROFILES_ACTIVE=dev

# ---- Nacos 服务发现 / 配置中心 ----
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=dev
# Nacos Config 开关（P2-17）：默认 false 不加载；启用时以 optional: 前缀导入，Nacos 不可达也不阻塞启动
MOYUE_NACOS_CONFIG_ENABLED=false

# ---- MySQL（敏感项，prod/test 必填）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=moyue
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Elasticsearch（检索域，承载于 moyue-reader，只读）----
ES_URIS=http://localhost:9200

# ---- JWT（网关与账号服务共享密钥，prod 必填且需强随机）----
MOYUE_JWT_SECRET=

# ---- 邮件渠道（触达域，承载于 moyue-reader；dev 默认指向 MailHog，无认证）----
MOYUE_MAIL_HOST=localhost
MOYUE_MAIL_PORT=1025
MOYUE_MAIL_USERNAME=
MOYUE_MAIL_PASSWORD=
MOYUE_MAIL_FROM=no-reply@moyue.local

# ---- Sentinel（网关限流 / 熔断，P2-17）----
MOYUE_SENTINEL_ENABLED=true
# 每路由默认 QPS 上限（可配）
MOYUE_SENTINEL_ROUTE_QPS=100

# ---- XXL-Job（执行器承载于 moyue-admin）----
XXL_JOB_ADMIN_ADDRESSES=http://localhost:8088/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=
